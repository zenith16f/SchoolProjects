---
import Base from "../layouts/Base.astro";

// La página de inicio es un selector directo: lo primero que se ve son las
// dos calculadoras. La teoría vive en /guia/ como enlace secundario.
const tools = [
  {
    href: "/cidr/",
    data: "cidr",
    kicker: "Herramienta 01",
    title: "Calculadora CIDR",
    accent: "bg-ip-blue",
    description:
      "Analiza cualquier dirección IPv4 con su prefijo o máscara. Obtén la red, el broadcast, el rango de hosts y el binario; después divide la red en subredes iguales.",
    points: [
      "Red, broadcast, primer y último host",
      "Máscara decimal, prefijo y wildcard",
      "División por número de subredes o por hosts",
    ],
    icon: "network",
  },
  {
    href: "/vlsm/",
    data: "vlsm",
    kicker: "Herramienta 02",
    title: "Calculadora VLSM",
    accent: "bg-ip-green",
    description:
      "Reparte una red base entre subredes de distinto tamaño. El algoritmo ordena de mayor a menor, calcula cada máscara y asigna bloques contiguos sin solapamientos.",
    points: [
      "Máscaras variables según hosts requeridos",
      "Desperdicio, espacio libre y aprovechamiento",
      "Error claro si la red base no alcanza",
    ],
    icon: "layers",
  },
];
---

<Base
  title="Calculadora IP — CIDR y VLSM"
  description="Calculadora IP CIDR y VLSM para analizar subredes, rangos, broadcast, máscaras y repartir direcciones según los hosts requeridos."
>
  <section class="container-page relative pt-10 sm:pt-14">
    <div class="rise max-w-2xl">
      <p class="eyebrow flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-ip-green"></span>
        Redes de Computadoras · Proyecto 2
      </p>
      <h1 class="mt-4 text-3xl font-semibold leading-tight text-bone-50 sm:text-4xl">
        ¿Qué vas a calcular?
      </h1>
      <p class="mt-3 text-sm leading-relaxed text-meteor-300 sm:text-base">
        Analiza una red con <strong class="font-semibold text-bone-100">CIDR</strong> o
        repártela entre subredes a la medida con
        <strong class="font-semibold text-bone-100">VLSM</strong>. Los resultados se
        recalculan mientras escribes y todo ocurre en tu navegador.
      </p>
    </div>

    <!-- Opciones principales: las dos calculadoras -->
    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      {
        tools.map((tool, index) => (
          <a
            href={tool.href}
            data-calculator={tool.data}
            class:list={[
              "panel group relative overflow-hidden p-6 transition duration-300 hover:-translate-y-1 hover:border-white/20 sm:p-8",
              index === 0 ? "rise rise-1" : "rise rise-2",
            ]}
          >
            <span class:list={["absolute inset-x-0 top-0 h-0.5", tool.accent]}></span>
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="eyebrow">{tool.kicker}</p>
                <h2 class="mt-2 text-2xl font-semibold text-bone-50">{tool.title}</h2>
              </div>
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] text-bone-100 transition group-hover:border-white/20">
                {tool.icon === "network" ? (
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
                    <circle cx="12" cy="5" r="2.2" stroke="currentColor" stroke-width="1.5"></circle>
                    <circle cx="5" cy="19" r="2.2" stroke="currentColor" stroke-width="1.5"></circle>
                    <circle cx="19" cy="19" r="2.2" stroke="currentColor" stroke-width="1.5"></circle>
                    <path d="M12 7.2v4.3M10.5 11.5 6.5 17M13.5 11.5l4 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
                    <path d="m12 3 8 4.5-8 4.5-8-4.5L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
                    <path d="m4 12 8 4.5 8-4.5M4 16.5 12 21l8-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                )}
              </span>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-meteor-300">{tool.description}</p>
            <ul class="mt-5 space-y-2.5">
              {tool.points.map((point) => (
                <li class="flex items-start gap-2.5 text-sm text-meteor-200">
                  <svg viewBox="0 0 16 16" class="mt-0.5 h-4 w-4 shrink-0 text-ip-green" fill="none" aria-hidden="true">
                    <path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  {point}
                </li>
              ))}
            </ul>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-bone-100">
              Abrir calculadora
              <svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" aria-hidden="true">
                <path d="M3 8h9M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
        ))
      }
    </div>

    <!-- Secundario: guía y notas -->
    <div class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-white/[0.06] pt-6">
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-xs text-meteor-400">
        <span class="inline-flex items-center gap-1.5">
          <span class="dot bg-ip-blue"></span> 40 pruebas automáticas
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="dot bg-ip-green"></span> 100 % en tu navegador
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="dot bg-ip-red"></span> sin instalación
        </span>
      </div>
      <a
        href="/guia/"
        class="inline-flex items-center gap-2 text-sm font-medium text-ip-blue transition hover:text-ip-blue-soft"
      >
        Guía de estudio: teoría, fórmulas y casos
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" aria-hidden="true">
          <path d="M3 8h9M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </section>
</Base>
